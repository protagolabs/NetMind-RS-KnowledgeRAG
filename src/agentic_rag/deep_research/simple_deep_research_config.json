{
  "rag_api": {
    "url": "http://localhost:8000",
    "timeout": 30,
    "search_type": "hierarchical",
    "model": "gpt-4o"
  },
  "openai": {
    "model": "gpt-4o",
    "temperature": 0.1,
    "max_tokens": 4000,
    "timeout": 120
  },
  "research": {
    "default_max_depth": 5,
    "default_time_limit_minutes": 5,
    "max_failed_attempts": 3,
    "min_remaining_time_minutes": 1
  },
  "output": {
    "save_intermediate_results": false,
    "output_format": "json",
    "include_timestamps": true
  },
  "logging": {
    "level": "INFO",
    "show_progress": true,
    "show_emojis": true
  }
} 